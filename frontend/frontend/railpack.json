{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "npm install -g npm@10.9.2",
        "npm ci --legacy-peer-deps --include=dev"
      ]
    },
    "build": {
      "commands": [
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm start"
  }
}